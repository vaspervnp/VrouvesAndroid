<Project Sdk="Microsoft.NET.Sdk">
  <!-- The game's logic (Vrouves/Game) without Android: plays the stages headless.
       dotnet run -c Release -project tests/Sim [plan] [stage ...] -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>annotations</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Vrouves/Game/*.cs" />
  </ItemGroup>
</Project>
